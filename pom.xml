<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>SelenoidChecker</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <aspectj.version>1.9.19</aspectj.version>
    <io.qameta.allure-selenide.version>2.21.0</io.qameta.allure-selenide.version>
    <io.qameta.allure-maven.version>2.12.0</io.qameta.allure-maven.version>
    <io.qameta.allure-junit5.version>2.21.0</io.qameta.allure-junit5.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <selenide.java.version>6.13.0</selenide.java.version>
    <selenide-selenoid.version>2.3.6</selenide-selenoid.version>
    <reflections.version>0.10.2</reflections.version>
    <junit.jupiter.vesions>5.9.2</junit.jupiter.vesions>
    <maven.surefire.plugin>3.0.0</maven.surefire.plugin>
    <maven.failsafe.plugin>3.0.0</maven.failsafe.plugin>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <testrail.api.version>2.0.1</testrail.api.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>jakarta.xml.ws</groupId>
      <artifactId>jakarta.xml.ws-api</artifactId>
